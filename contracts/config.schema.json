{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bear-den-tv.local/contracts/config.schema.json",
  "title": "Bear Den TV configuration (schema_version 1)",
  "description": "Structural schema for $XDG_CONFIG_HOME/bear-den-tv/config.json. Semantic validation (unique ids, references, approved launch arguments, interface ownership, certificate readability) is implemented in internal/config and documented in config.md.",
  "type": "object",
  "properties": {
    "schema_version": {"const": 1},
    "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "device": {
      "type": "object",
      "properties": {
        "display_name": {"type": "string", "minLength": 1, "maxLength": 64},
        "preferred_display": {"type": "string", "minLength": 1}
      },
      "required": ["display_name", "preferred_display"],
      "additionalProperties": false
    },
    "ui": {"$ref": "layout.schema.json#/properties/ui"},
    "applications": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 64},
          "adapter": {"enum": ["plex-htpc", "vacuumtube", "moonlight", "spotify", "jellyfin", "retroarch", "netflix", "disney-plus", "hulu", "browser"]},
          "launch": {
            "type": "object",
            "properties": {
              "kind": {"const": "flatpak"},
              "app_id": {"type": "string", "minLength": 3, "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$"},
              "args": {"type": "array", "items": {"type": "string", "pattern": "^--[a-z][a-z0-9-]{0,40}$"}, "maxItems": 16}
            },
            "required": ["kind", "app_id", "args"],
            "additionalProperties": false
          },
          "home_policy": {"enum": ["pause-if-supported", "leave-running"]},
          "remote_enabled": {"type": "boolean"},
          "hide_when_missing": {"type": "boolean", "description": "Optional app: when true its tile is hidden (state.applications[].hidden) while its Flatpak is not installed, instead of showing Not installed. Absent means false."},
          "enabled": {"type": "boolean", "description": "Absent means true. false: the owner turned the app off (TV Settings -> Streaming sites); it has no tile (state.applications[].hidden). Only web adapters can be turned off from the TV (IPC app.enable)."},
          "web": {
            "type": "object",
            "description": "Web adapters only (netflix, disney-plus, hulu, browser): the page Chromium opens. Owner-edited on the TV, never sent by phones. Semantic rules in config.md rule 11: https only, no user name or password, no port, the adapter's own host (any host for browser).",
            "properties": {
              "url": {"type": "string", "minLength": 9, "maxLength": 512, "pattern": "^https://[^\\s]+$"}
            },
            "additionalProperties": false
          }
        },
        "required": ["id", "label", "adapter", "launch", "home_policy", "remote_enabled"],
        "additionalProperties": false,
        "allOf": [
          {"if": {"properties": {"adapter": {"enum": ["netflix", "disney-plus", "hulu"]}}, "required": ["adapter"]},
           "then": {"required": ["web"], "properties": {"web": {"required": ["url"]}}}}
        ]
      }
    },
    "sections": {"$ref": "layout.schema.json#/properties/sections"},
    "plex_content": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "connection_ref": {"type": ["string", "null"], "minLength": 1, "description": "Opaque reference into the secret store; never the token itself."},
        "server_url": {"type": ["string", "null"], "pattern": "^https?://"},
        "library_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "required": ["enabled", "connection_ref"],
      "additionalProperties": false,
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {"connection_ref": {"type": "string", "minLength": 1}, "server_url": {"type": "string"}}, "required": ["server_url"]}
    },
    "remote": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "transport": {"enum": ["trusted-lan-http", "https"]},
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "interfaces": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "description": "Interface names (e.g. enp1s0). The coordinator binds every address of the selected interface, IPv4 and IPv6 alike, and nothing else."},
        "allowed_hosts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "description": "Extra Host header values accepted besides the bound literal addresses (e.g. a .local name or a certificate hostname)."},
        "mdns": {"type": "boolean"},
        "http_layout_editing": {"type": "boolean"},
        "now_playing": {"type": "boolean", "description": "Optional, default true. Paired phones with the controller permission see what the app in front reports it is playing (state.now_playing); false hides it (contracts/config.md)."},
        "pairing_expiry_seconds": {"type": "integer", "minimum": 30, "maximum": 300},
        "pairing_max_attempts": {"type": "integer", "minimum": 1, "maximum": 10},
        "https": {
          "type": "object",
          "properties": {
            "certificate_file": {"type": ["string", "null"], "minLength": 1},
            "private_key_file": {"type": ["string", "null"], "minLength": 1}
          },
          "required": ["certificate_file", "private_key_file"],
          "additionalProperties": false
        }
      },
      "required": ["enabled", "transport", "port", "interfaces", "allowed_hosts", "mdns", "http_layout_editing", "pairing_expiry_seconds", "pairing_max_attempts", "https"],
      "additionalProperties": false,
      "allOf": [
        {"if": {"properties": {"enabled": {"const": true}}}, "then": {"properties": {"interfaces": {"minItems": 1}}}},
        {"if": {"properties": {"enabled": {"const": true}, "transport": {"const": "https"}}},
         "then": {"properties": {"https": {"properties": {"certificate_file": {"type": "string", "minLength": 1}, "private_key_file": {"type": "string", "minLength": 1}}}}}}
      ]
    },
    "cache": {
      "type": "object",
      "properties": {"artwork_max_mib": {"type": "integer", "minimum": 32, "maximum": 8192}},
      "required": ["artwork_max_mib"],
      "additionalProperties": false
    },
    "startup": {
      "type": "object",
      "properties": {
        "autostart_enabled": {"type": "boolean"},
        "tune_apps": {"type": "boolean", "description": "Apply the best playback settings for this box automatically (docs/APP_PERFORMANCE.md). Default true."}
      },
      "required": ["autostart_enabled"],
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "properties": {"telemetry_enabled": {"const": false}},
      "required": ["telemetry_enabled"],
      "additionalProperties": false
    },
    "onboarding": {
      "type": "object",
      "properties": {
        "completed": {"type": "boolean"},
        "lan_consent": {"type": "boolean", "description": "True only after the user explicitly accepted local network control on the TV."}
      },
      "required": ["completed", "lan_consent"],
      "additionalProperties": false
    },
    "apps": {
      "type": "object",
      "description": "Optional; absent means auto_update on and Chromium for every web app. App installs from Flathub and the web apps' browser (contracts/config.md).",
      "properties": {
        "auto_update": {"type": "boolean", "description": "Keep apps up to date: update the apps installed for this user while the TV is idle."},
        "browser": {"enum": ["chromium", "brave"], "description": "The Browser tile's browser (absent = chromium). Rule 3: the browser row's launch.app_id is this browser's Flatpak id."},
        "streaming_browser": {"enum": ["chromium", "brave"], "description": "The streaming sites' browser (absent = chromium; brave is unverified for streaming). Rule 3: their rows' launch.app_id is this browser's Flatpak id."}
      },
      "required": ["auto_update"],
      "additionalProperties": false
    },
    "achievements": {
      "type": "object",
      "description": "Optional; absent means on. Den badges from local counters (contracts/config.md). false: nothing is counted.",
      "properties": {"enabled": {"type": "boolean"}},
      "required": ["enabled"],
      "additionalProperties": false
    },
    "weather": {
      "type": "object",
      "description": "Optional; absent means off. Local weather for the Home header and scene (contracts/config.md). Coordinates carry at most 2 decimals; never a URL, key or token.",
      "properties": {
        "enabled": {"type": "boolean"},
        "place": {
          "type": ["object", "null"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 80},
            "region": {"type": "string", "maxLength": 80},
            "country": {"type": "string", "maxLength": 80},
            "latitude": {"type": "number", "minimum": -90, "maximum": 90},
            "longitude": {"type": "number", "minimum": -180, "maximum": 180}
          },
          "required": ["name", "region", "country", "latitude", "longitude"],
          "additionalProperties": false
        },
        "units": {"enum": ["celsius", "fahrenheit"]},
        "scene": {"type": "boolean", "description": "The weather drives the Home backdrop (rain, snow, veil)."}
      },
      "required": ["enabled", "place", "units", "scene"],
      "additionalProperties": false,
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {"place": {"type": "object"}}}
    },
    "cec": {
      "type": "object",
      "description": "Optional; absent means off. TV control over HDMI-CEC (contracts/config.md): the TV follows Bear Den on and off and switches to its input; the phone's volume buttons may drive the TV.",
      "properties": {
        "enabled": {"type": "boolean"},
        "volume_target": {"enum": ["pc", "tv"]}
      },
      "required": ["enabled", "volume_target"],
      "additionalProperties": false
    },
    "playback": {
      "type": "object",
      "description": "Optional. Playback settings chosen by hand in TV Settings → Advanced playback; automatic tuning uses them instead of its own choice while this box still offers them (docs/APP_PERFORMANCE.md).",
      "properties": {
        "overrides": {
          "type": "object",
          "description": "Adapter → setting id → option value. A missing setting means automatic.",
          "maxProperties": 16,
          "propertyNames": {"pattern": "^[a-z][a-z0-9-]{1,31}$"},
          "additionalProperties": {
            "type": "object",
            "maxProperties": 32,
            "propertyNames": {"pattern": "^[a-z][a-z0-9_]{1,31}$"},
            "additionalProperties": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,31}$"}
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["schema_version", "revision", "device", "ui", "applications", "sections", "plex_content", "remote", "cache", "startup", "privacy", "onboarding"],
  "additionalProperties": false
}
