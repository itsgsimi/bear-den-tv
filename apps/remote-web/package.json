{
  "name": "bear-den-tv-remote-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Bear Den TV phone remote and web layout editor: static assets embedded by the coordinator binary.",
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "tsc --noEmit -p tsconfig.json && eslint .",
    "test": "vitest run && playwright test --pass-with-no-tests",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --pass-with-no-tests",
    "serve": "node scripts/serve-dist.mjs"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.4",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.0.18"
  },
  "engines": {
    "node": ">=22"
  }
}
