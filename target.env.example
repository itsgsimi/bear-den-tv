# Copy to target.env (untracked) and fill in your TV machine's details.
# Read by scripts/target.sh, deploy-target.sh, e2e-target.sh and measure-target.sh.
# Environment variables of the same name override this file.

# ssh destination of the TV machine (key-based login, BatchMode).
BDTV_TARGET=you@tv.local

# Checkout path on the TV, relative to the remote home directory (or absolute).
BDTV_TARGET_DIR=bear-den-tv

# Optional: a command run on the TV after a deploy to check other services the
# box hosts (e.g. a DNS server). Non-zero exit fails the deploy. Empty = skipped.
BDTV_TARGET_HEALTH_CMD=

# Optional: where scripts/bootstrap-toolchain.sh put the toolchain ON THE TV
# (the TV shell loads Qt from <this>/env/lib). Empty = ~/.bdtv-toolchain of
# the BDTV_TARGET user.
BDTV_TARGET_TOOLCHAIN=
